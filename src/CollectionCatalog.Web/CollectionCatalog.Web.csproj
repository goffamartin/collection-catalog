<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>collection-catalog</UserSecretsId>
    <!-- The SDK adds the package with blazor.web.js only when restore sees .razor files.
         The Dockerfile restores the bare .csproj (layer cache), so it is requested explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Tailwind CSS: the build generates wwwroot/css/app.css when the npm packages are installed (npm ci in the repo root).
       Docker builds the CSS in its own stage; CI tests do not need it. -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RepoRoot>
  </PropertyGroup>
  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" Condition="Exists('$(RepoRoot)/node_modules/@tailwindcss/cli')">
    <Exec Command="npm run build:css --silent" WorkingDirectory="$(RepoRoot)" />
    <!-- The file is created after the wwwroot/** globs were evaluated – add it so it gets into the static assets even on the first build. -->
    <ItemGroup>
      <Content Remove="wwwroot\css\app.css" />
      <Content Include="wwwroot\css\app.css" />
    </ItemGroup>
  </Target>

</Project>
