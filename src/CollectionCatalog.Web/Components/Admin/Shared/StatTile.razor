@* Tile with a summary number. Icons are enumerated – Tailwind generates only classes it finds verbatim in the code. *@
<div class="card relative overflow-hidden p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="text-xs font-medium text-stone-500 sm:text-sm">@Label</p>
            <p class="mt-1.5 truncate text-xl font-semibold tracking-tight tabular-nums sm:text-2xl @(Accent ? "text-amber-700" : "text-stone-900")">@Value</p>
            @if (Note is not null)
            {
                <p class="mt-0.5 text-xs text-stone-500">@Note</p>
            }
        </div>
        <span class="hidden size-10 shrink-0 items-center justify-center rounded-xl sm:flex @(Accent ? "bg-amber-50 text-amber-600" : "bg-stone-100 text-stone-500")">
            @switch (Icon)
            {
                case Icons.Items: <span class="icon-[lucide--layers] size-5"></span> break;
                case Icons.Wallet: <span class="icon-[lucide--wallet] size-5"></span> break;
                case Icons.Trend: <span class="icon-[lucide--trending-up] size-5"></span> break;
                case Icons.Camera: <span class="icon-[lucide--camera-off] size-5"></span> break;
            }
        </span>
    </div>
</div>

@code {
    public enum Icons { Items, Wallet, Trend, Camera }

    [Parameter, EditorRequired]
    public string Label { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Value { get; set; } = default!;

    [Parameter]
    public string? Note { get; set; }

    [Parameter]
    public Icons Icon { get; set; }

    [Parameter]
    public bool Accent { get; set; }
}
