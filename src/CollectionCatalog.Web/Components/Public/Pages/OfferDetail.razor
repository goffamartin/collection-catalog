@page "/nabidka/{ListingId:int}/{Slug?}"
@inject PublicItemQuery Query
@inject NavigationManager Navigation

@if (_item?.Offer is not { } offer)
{
    return;
}

<Seo Title="@T["{0} – offer", _item.Name]" Path="@(_item.OfferUrl!)" PathIn="language => PublicUrls.Offer(offer.ListingId, _item.AllNames.Get(language) ?? _item.Name)" Description="@($"{PublicUrls.Price(offer.AskingPrice)}. {offer.PublicNote ?? _item.PublicDescription}")"
     ImageKey="@_item.Images.FirstOrDefault()?.FileKey" />

<div class="site-container pt-8 sm:pt-10">
    <Breadcrumbs Items="BreadcrumbItems" />
    <JsonLd Data="StructuredData.Offer(_item)" />

    <ItemShowcase Item="_item">
        <Highlight>
            <div class="mt-6 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-stone-200/80">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="text-xs font-semibold tracking-wide text-stone-500 uppercase">@(offer.AskingPrice is null ? T["Price"] : T["Asking price"])</p>
                        <p class="mt-0.5 font-display text-3xl font-medium text-stone-900">@PublicUrls.Price(offer.AskingPrice)</p>
                    </div>
                    @if (offer.Status == ListingStatus.Reserved)
                    {
                        <span class="badge bg-amber-100 px-3 py-1 text-sm text-amber-900 ring-1 ring-amber-300">
                            <span class="icon-[lucide--clock] size-3.5"></span> @T["Reserved"]
                        </span>
                    }
                </div>
                <ul class="mt-4 flex flex-wrap gap-2 text-sm">
                    @if (offer.AcceptsOffers)
                    {
                        <li class="badge bg-stone-100 px-3 py-1 text-stone-700"><span class="icon-[lucide--hand-coins] size-3.5"></span> @T["You can propose a price"]</li>
                    }
                    @if (offer.OpenToTrade)
                    {
                        <li class="badge bg-stone-100 px-3 py-1 text-stone-700"><span class="icon-[lucide--repeat] size-3.5"></span> @T["Exchange possible"]</li>
                    }
                </ul>
                @if (offer.PublicNote is not null)
                {
                    <div class="mt-4 space-y-3 border-t border-stone-100 pt-4 text-sm leading-relaxed text-stone-700">
                        <TextBlock Text="@offer.PublicNote" />
                    </div>
                }
            </div>
        </Highlight>
        <ChildContent>
            <InquiryForm ListingId="offer.ListingId" AcceptsOffers="offer.AcceptsOffers" CssClass="mt-8"
                         Title="@(offer.Status == ListingStatus.Reserved ? T["Interested in case the reservation falls through?"] : T["I am interested"])"
                         Description="@T["Leave us your contact and a message – we will get back to you by e-mail."]"
                         SubmitText="@T["Send interest"]"
                         MessagePlaceholder="@(offer.OpenToTrade ? T["Hello, I am interested in this piece. I could also offer in exchange…"] : T["Hello, I am interested in this piece…"])" />
        </ChildContent>
    </ItemShowcase>

    @if (_item.RelatedOffers.Count > 0)
    {
        <section class="mt-20 border-t border-stone-200/70 pt-14">
            <p class="eyebrow">@T["Offer"]</p>
            <h2 class="display-title mt-3 text-3xl">@T["More pieces for sale"]</h2>
            <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:grid-cols-4">
                @foreach (var related in _item.RelatedOffers)
                {
                    <OfferCard Offer="related" />
                }
            </div>
        </section>
    }
</div>

@code {
    private PublicItemDetail? _item;

    private List<(string Name, string? Path)> BreadcrumbItems => [(T["Offer"], PublicUrls.Offers), (_item!.Name, null)];

    [Parameter] public int ListingId { get; set; }
    [Parameter] public string? Slug { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _item = await Query.GetOfferAsync(ListingId);
        if (_item is null)
        {
            Navigation.NotFound();
            return;
        }

        if (Slug != _item.Slug)
        {
            Navigation.NavigateTo(_item.OfferUrl!, replace: true);
        }
    }
}
