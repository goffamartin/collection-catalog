@page "/nabidka"
@inject PublicItemQuery Query

@if (_offers is null)
{
    return;
}

<Seo Title="@T["Offer"]" Path="nabidka" Description="@T["Pieces from the collection for sale or exchange."]" />

<div class="site-container pt-10 sm:pt-14">
    <p class="eyebrow">@T["For sale and exchange"]</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
        <h1 class="display-title text-4xl sm:text-5xl">@T["Offer"]</h1>
        @if (_offers.Count > 0)
        {
            <p class="text-sm text-stone-500">@T.Plural("{0} piece|{0} pieces", _offers.Count)</p>
        }
    </div>
    <div class="gold-rule mt-6"></div>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-stone-600">
        @T["Pieces from the collection we offer for sale or exchange. For each you can leave your contact and a message, or propose your own price."]
    </p>

    @if (_offers.Count == 0)
    {
        <div class="mt-16 flex flex-col items-center text-center">
            <span class="flex size-14 items-center justify-center rounded-full bg-white text-stone-400 ring-1 ring-stone-200">
                <span class="icon-[lucide--package-open] size-6"></span>
            </span>
            <p class="mt-4 font-display text-xl">@T["Nothing on offer at the moment"]</p>
            <p class="mt-1 text-sm text-stone-500">
                @T["Looking for a particular piece?"] <a href="kontakt" class="text-link">@T["Write to us"]</a>@T[", or browse the"] <a href="sbirka" class="text-link">@AppText.In("link", "collection")</a>.
            </p>
        </div>
    }
    else
    {
        <h2 class="sr-only">@T["Pieces on offer"]</h2>
        <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:grid-cols-3 lg:grid-cols-4">
            @foreach (var offer in _offers)
            {
                <OfferCard Offer="offer" />
            }
        </div>
    }
</div>

@code {
    private List<PublicOfferCard>? _offers;

    protected override async Task OnInitializedAsync() => _offers = await Query.GetOffersAsync();
}
