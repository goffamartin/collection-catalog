@* Item detail – gallery and data. Shared by the collection detail and the offer detail. *@
<div class="mt-6 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
    @* Gallery: thumbnails switch the main photo, a click on it opens full screen (site.js). Without JS the first photo stays. *@
    <div data-gallery class="lg:sticky lg:top-24 lg:self-start">
        @if (Item.Images.Count == 0)
        {
            <div class="photo-well flex aspect-square items-center justify-center rounded-3xl ring-1 ring-stone-200/80">
                <span class="icon-[lucide--image-off] size-12 text-stone-300"></span>
            </div>
        }
        else
        {
            var first = Item.Images[0];
            <button type="button" data-gallery-open class="group block w-full cursor-zoom-in">
                <PhotoFrame Image="first" Alt="@ImageAlt(first)" Size="800" Sizes="(min-width: 1024px) 36rem, 100vw" Priority GalleryMain
                            CssClass="aspect-square rounded-3xl shadow-lg shadow-stone-900/5 ring-1 ring-stone-200/80" ImageCssClass="p-4 sm:p-6">
                    <span class="absolute right-4 bottom-4 flex size-10 items-center justify-center rounded-full bg-white/90 text-stone-700 opacity-0 shadow ring-1 ring-stone-200 transition group-hover:opacity-100 pointer-coarse:opacity-100">
                        <span class="icon-[lucide--maximize-2] size-4"></span>
                    </span>
                </PhotoFrame>
            </button>
            <p data-gallery-caption class="mt-3 min-h-5 text-center text-sm text-stone-500">@first.Caption</p>

            <ul class="@($"mt-4 grid grid-cols-5 gap-2 sm:gap-3 {(Item.Images.Count == 1 ? "hidden" : "")}")">
                @for (var i = 0; i < Item.Images.Count; i++)
                {
                    var image = Item.Images[i];
                    <li>
                        <button type="button" data-gallery-thumb
                                data-src="@PublicUrls.Image(image.FileKey, 800)" data-src-large="@PublicUrls.Image(image.FileKey, 1600)"
                                data-caption="@image.Caption" data-alt="@ImageAlt(image)" aria-current="@(i == 0 ? "true" : null)"
                                aria-label="@T["Photo {0}: {1}", i + 1, image.ImageType.Label()]"
                                class="photo-well block aspect-square w-full rounded-xl ring-1 ring-stone-200 transition hover:ring-amber-400 aria-[current=true]:ring-2 aria-[current=true]:ring-amber-500">
                            <img src="@PublicUrls.Image(image.FileKey, 400)" alt="" loading="lazy" class="size-full object-cover" />
                        </button>
                    </li>
                }
            </ul>

            <dialog data-gallery-dialog aria-label="@T["Photos: {0}", Item.Name]" class="m-0 h-dvh max-h-none w-screen max-w-none bg-stone-950/95 p-0 text-white backdrop:bg-transparent">
                <div class="relative flex h-full flex-col">
                    <div class="flex items-center justify-between px-4 py-3 text-sm text-stone-300">
                        <span data-gallery-counter aria-live="polite"></span>
                        <button type="button" data-gallery-close class="flex size-10 items-center justify-center rounded-full hover:bg-white/10" aria-label="@T["Close"]">
                            <span class="icon-[lucide--x] size-5"></span>
                        </button>
                    </div>
                    <div data-gallery-backdrop class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16">
                        <img data-gallery-large alt="" class="max-h-full max-w-full object-contain select-none" />
                        <button type="button" data-gallery-prev class="absolute left-2 flex size-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 sm:left-4" aria-label="@T["Previous photo"]">
                            <span class="icon-[lucide--chevron-left] size-6"></span>
                        </button>
                        <button type="button" data-gallery-next class="absolute right-2 flex size-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 sm:right-4" aria-label="@T["Next photo"]">
                            <span class="icon-[lucide--chevron-right] size-6"></span>
                        </button>
                    </div>
                    <p data-gallery-large-caption class="min-h-12 px-4 py-3 text-center text-sm text-stone-300"></p>
                </div>
            </dialog>
        }
    </div>

    <div>
        <p class="eyebrow">@Item.TypeName</p>
        <h1 class="display-title mt-3 text-3xl leading-tight sm:text-4xl lg:text-[2.75rem]">@Item.Name</h1>
        @if (Summary is { } summary)
        {
            <p class="mt-3 text-lg text-stone-600">@summary</p>
        }
        <div class="gold-rule mt-6"></div>

        @Highlight

        @if (Item.PublicDescription is not null)
        {
            <div class="mt-6 space-y-4 text-[1.05rem] leading-relaxed text-stone-700">
                <TextBlock Text="@Item.PublicDescription" />
            </div>
        }

        <dl class="mt-8 divide-y divide-stone-200/80 rounded-2xl bg-white/70 px-5 shadow-xs ring-1 ring-stone-200/80">
            <DetailRow Label="@T["Type"]" Value="@Item.TypeName" />
            <DetailRow Label="@T["Country"]" Value="@Item.CountryName" />
            <DetailRow Label="@T["Period"]" Value="@Item.Years" />
            <DetailRow Label="@T["Condition"]" Value="@Item.Condition.Label()" />
            <DetailRow Label="@T["Originality"]" Value="@(Item.Originality == Originality.Unknown ? null : Item.Originality.Label())" />
            <DetailRow Label="@T["Accessories"]" Value="@Accessories" />
            @if (Item.Categories.Count > 0)
            {
                <div class="flex gap-4 py-3.5">
                    <dt class="w-28 shrink-0 text-sm text-stone-500 sm:w-36">@T["Categories"]</dt>
                    <dd class="flex flex-wrap gap-1.5">
                        @foreach (var category in Item.Categories)
                        {
                            <a href="@($"sbirka?kategorie={category.Id}")" class="badge bg-stone-100 text-stone-700 ring-1 ring-stone-200 hover:ring-amber-400">@category.Name</a>
                        }
                    </dd>
                </div>
            }
        </dl>

        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PublicItemDetail Item { get; set; } = null!;

    /// <summary>Content right under the heading (e.g. the offer price).</summary>
    [Parameter] public RenderFragment? Highlight { get; set; }

    /// <summary>Content under the data (inquiry form…).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Summary => string.Join(" · ", new[] { Item.CountryName, Item.Years }.Where(s => s is not null)) is { Length: > 0 } s ? s : null;

    private string? Accessories => string.Join(", ", new[]
    {
        Item.HasBox ? AppText.In("accessory", "original box") : null,
        Item.HasCertificate ? AppText.In("accessory", "certificate") : null,
        Item.HasDocumentation ? AppText.In("accessory", "documentation") : null,
    }.Where(s => s is not null)) is { Length: > 0 } s ? char.ToUpper(s[0], System.Globalization.CultureInfo.CurrentCulture) + s[1..] : null;

    private string ImageAlt(PublicImage image) =>
        image.Caption ?? $"{Item.Name} – {image.ImageType.Label().ToLower(System.Globalization.CultureInfo.CurrentCulture)}";
}
