@* Item card in a grid: photo, name, country and period, the type as a badge. *@
<a href="@(Href ?? Item.Url)" class="group block">
    <PhotoFrame Image="Item.Image" Alt="@Item.Name" Sizes="(min-width: 1024px) 18rem, (min-width: 768px) 33vw, 50vw"
                CssClass="aspect-[4/5] rounded-xl ring-1 ring-stone-200/60 transition group-hover:ring-amber-300/70"
                ImageCssClass="p-3 transition duration-500 group-hover:scale-[1.04] sm:p-4">
        @if (Item.TypeName is not null)
        {
            <span class="badge absolute top-2.5 left-2.5 bg-white/90 text-stone-700 shadow-xs ring-1 ring-stone-200/80 backdrop-blur">@Item.TypeName</span>
        }
        @Badge
    </PhotoFrame>
    <div class="mt-3 px-0.5">
        <h3 class="font-display text-[1.05rem] leading-snug font-medium text-stone-900 transition group-hover:text-amber-800 sm:text-lg">@Item.Name</h3>
        @if (Subtitle is { } subtitle)
        {
            <p class="mt-1 text-sm text-stone-500">@subtitle</p>
        }
        @Footer
    </div>
</a>

@code {
    [Parameter, EditorRequired] public PublicItemCard Item { get; set; } = null!;

    /// <summary>Link of the card; the detail in the collection by default.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Extra content in the corner of the photo (e.g. the offer price).</summary>
    [Parameter] public RenderFragment? Badge { get; set; }

    /// <summary>Extra line under the name.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    private string? Subtitle => string.Join(" · ", new[] { Item.CountryName, Item.Years }.Where(s => s is not null)) is { Length: > 0 } s ? s : null;
}
