<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repo is self-contained: only nuget.org, ignoring any machine-wide feeds and source mappings. -->
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
